# harden-token-stack.env
# Disables outbound telemetry / update-check traffic for the token-optimization
# stack. Source it from your shell rc, or paste the exports directly.
#
#   echo 'source ~/harden-token-stack.env' >> ~/.zshrc   # or ~/.bashrc
#   source ~/harden-token-stack.env
#
# Verify afterwards:
#   codegraph telemetry status
#   env | grep -E 'DO_NOT_TRACK|CODEGRAPH|TELEMETRY'

# Cross-tool standard — honored by CodeGraph and many other CLIs. Disables both
# CodeGraph telemetry AND its daily GitHub update check.
export DO_NOT_TRACK=1

# CodeGraph-specific opt-out (belt-and-suspenders alongside DO_NOT_TRACK).
export CODEGRAPH_TELEMETRY=0

# Turn off ONLY CodeGraph's update check while leaving telemetry decisions to the
# vars above. (Redundant when DO_NOT_TRACK=1, harmless to keep.)
export CODEGRAPH_NO_UPDATE_CHECK=1

# --- Optional: one-time persistent opt-out stored by CodeGraph itself ---
# Run once in a shell (not an env var); it also deletes any unsent buffered data:
#   codegraph telemetry off
